          "bus": "analog",
          "supporting": [
            {"type": "resistor", "value": "1R", "role": "current sense"}
          ]
        },
        {
          "subsystem": "MOSFET Switch",
          "function": "N-channel MOSFET for PWM dimming control",
          "example_components": ["2N7002", "IRLML6344"],
          "bus": "digital"
        },
        {
          "subsystem": "Gate Resistor",
          "function": "Gate pull-down and series resistor for MOSFET",
          "example_components": [],
          "bus": "digital",
          "supporting": [
            {"type": "resistor", "value": "10k", "role": "gate pull-down"},
            {"type": "resistor", "value": "100R", "role": "gate series"}
          ]
        }
      ],
      "nets": [
        {"name": "LED_VCC", "pins": ["LED:ANODE"]},
        {"name": "LED_DRIVE", "pins": ["LED:CATHODE", "R_SENSE:IN"]},
        {"name": "LED_GND", "pins": ["R_SENSE:OUT", "FET:DRAIN"]},
        {"name": "GATE", "pins": ["FET:GATE", "R_SER:OUT"]},
        {"name": "PWM_IN", "pins": ["R_SER:IN"]}
      ]
    },
    {
      "id": "motor_driver",
      "name": "DC Motor Driver",
      "description": "H-bridge or single MOSFET motor driver with flyback protection",
