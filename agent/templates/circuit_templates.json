          "supporting": [
            {"type": "resistor", "value": "10k", "role": "pull-up"},
            {"type": "capacitor", "value": "100nF", "role": "debounce"},
            {"type": "button", "value": "SW_Push", "role": "reset"}
          ]
        },
        {
          "subsystem": "Status LED",
          "function": "GPIO-driven status LED on pin 2",
          "example_components": ["LED_0603"],
          "bus": "signal",
          "supporting": [
            {"type": "resistor", "value": "1k", "role": "current limiter"}
          ]
        }
      ],
      "nets": [
        {"name": "VCC_3V3", "pins": ["REG:OUT", "ESP:3V3"]},
        {"name": "GND", "pins": ["REG:GND", "ESP:GND", "BTN:GND"]},
        {"name": "EN", "pins": ["ESP:EN", "R:OUT", "C:POS"]},
        {"name": "GPIO2", "pins": ["ESP:GPIO2", "R:IN"]}
      ]
    },
    {
      "id": "sensor_station",
