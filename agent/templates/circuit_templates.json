{
  "templates": [
    {
      "id": "usb_power_supply_3v3",
      "name": "3.3V USB Power Supply",
      "description": "USB-powered 3.3V regulated supply with LED indicator and bypass caps",
      "keywords": ["usb", "power", "3.3v", "regulator", "ldo"],
      "subsystems": [
        {
          "subsystem": "USB Input",
          "function": "USB Type-C or Micro-USB connector for power input",
          "example_components": ["Connector_USB_C", "USB_B_Micro"],
          "bus": "power"
        },
        {
          "subsystem": "Power Regulation",
          "function": "3.3V LDO voltage regulator with input and output capacitors",
          "example_components": ["AMS1117-3.3", "AP2112K-3.3", "ME6211C33"],
          "bus": "power",
          "supporting": [
            {"type": "capacitor", "value": "10uF", "role": "input bulk"},
            {"type": "capacitor", "value": "100nF", "role": "input bypass"},
            {"type": "capacitor", "value": "10uF", "role": "output bulk"},
            {"type": "capacitor", "value": "100nF", "role": "output bypass"}
          ]
        },
        {
          "subsystem": "LED Indicator",
          "function": "Visible LED with current-limiting resistor to indicate power status",
          "example_components": ["LED_0603"],
          "bus": "signal",
          "supporting": [
            {"type": "resistor", "value": "1k", "role": "current limiter"}
          ],
          "avoid": ["LD271", "infrared", "IR"]
        }
      ],
      "nets": [
        {"name": "USB_VBUS", "pins": ["USB:VBUS", "REG:IN"]},
        {"name": "VCC_3V3", "pins": ["REG:OUT", "LED:ANODE"]},
        {"name": "GND", "pins": ["USB:GND", "REG:GND", "LED:CATHODE"]}
      ]
    },
    {
      "id": "esp32_minimal",
