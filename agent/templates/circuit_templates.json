          "bus": "power",
          "supporting": [
            {"type": "capacitor", "value": "10uF", "role": "decoupling"},
            {"type": "capacitor", "value": "100nF", "role": "bypass"}
          ]
        },
        {
          "subsystem": "Reset Circuit",
          "function": "Push-button reset with RC debounce",
          "example_components": [],
